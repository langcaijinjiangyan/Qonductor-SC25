OPENQASM 3.0;
include "stdgates.inc";
input float[64] _b_0_;
input float[64] _b_1_;
input float[64] _g_0_;
input float[64] _g_1_;
gate rzz(p0) _gate_q_0, _gate_q_1 {
  cx _gate_q_0, _gate_q_1;
  rz(p0) _gate_q_1;
  cx _gate_q_0, _gate_q_1;
}
bit[6] c;
qubit[6] q;
h q[0];
h q[1];
rzz(2*_g_0_) q[0], q[1];
h q[2];
rzz(2*_g_0_) q[1], q[2];
h q[3];
rzz(2*_g_0_) q[1], q[3];
rx(2*_b_0_) q[1];
rzz(2*_g_0_) q[2], q[3];
rx(2*_b_0_) q[2];
rx(2*_b_0_) q[3];
h q[4];
rzz(2*_g_0_) q[0], q[4];
h q[5];
rzz(2*_g_0_) q[0], q[5];
rx(2*_b_0_) q[0];
rzz(2*_g_1_) q[0], q[1];
rzz(2*_g_1_) q[1], q[2];
rzz(2*_g_1_) q[1], q[3];
rx(2*_b_1_) q[1];
rzz(2*_g_1_) q[2], q[3];
rx(2*_b_1_) q[2];
rx(2*_b_1_) q[3];
rzz(2*_g_0_) q[4], q[5];
rx(2*_b_0_) q[4];
rzz(2*_g_1_) q[0], q[4];
rx(2*_b_0_) q[5];
rzz(2*_g_1_) q[0], q[5];
rx(2*_b_1_) q[0];
rzz(2*_g_1_) q[4], q[5];
rx(2*_b_1_) q[4];
rx(2*_b_1_) q[5];
c[0] = measure q[0];
c[1] = measure q[1];
c[2] = measure q[2];
c[3] = measure q[3];
c[4] = measure q[4];
c[5] = measure q[5];
